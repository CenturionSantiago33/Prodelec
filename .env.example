# Plantilla de variables de entorno.
# Copiá este archivo a ".env.local" y completá con tus propios valores.
# ".env.local" NO se versiona (está ignorado); este archivo ".env.example" sí se sube.

# Usuario del panel de administración
ADMIN_USER=admin

# Contraseña del panel (cambiala por una segura)
ADMIN_PASSWORD=cambiar-esta-contrasena

# Secreto para firmar el token de sesión (cualquier cadena larga y aleatoria)
ADMIN_SECRET=cambiar-este-secreto-por-una-cadena-larga-y-aleatoria
